{
  "$defs": {
    "OutsideAuth": {
      "additionalProperties": false,
      "description": "Who a caller is. `introspection`: ask the organization's token check (url, secret_env).\n`jwt`: verify a signed access token from the organization's identity provider (issuer, audience,\nroles), as the MCP specification's OAuth 2.1 sign-in issues them.",
      "properties": {
        "agent_claim": {
          "default": "azp",
          "title": "Agent Claim",
          "type": "string"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "cache_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 0,
          "title": "Cache Seconds",
          "type": "integer"
        },
        "groups_claim": {
          "default": "groups",
          "title": "Groups Claim",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "kind": {
          "enum": [
            "introspection",
            "jwt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "default": "local",
          "enum": [
            "local",
            "external"
          ],
          "title": "Location",
          "type": "string"
        },
        "person_claim": {
          "default": "sub",
          "title": "Person Claim",
          "type": "string"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Roles",
          "type": "object"
        },
        "secret_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Env"
        },
        "tenant_claim": {
          "default": "tenant",
          "title": "Tenant Claim",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "kind"
      ],
      "title": "OutsideAuth",
      "type": "object"
    },
    "OutsideListen": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8110,
          "exclusiveMaximum": 65536,
          "exclusiveMinimum": 0,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "OutsideListen",
      "type": "object"
    },
    "OutsideRateLimit": {
      "additionalProperties": false,
      "description": "Tool calls and checks one caller (client) may make: `burst` at once, then `per_minute` a minute.",
      "properties": {
        "burst": {
          "default": 30,
          "maximum": 1000,
          "minimum": 1,
          "title": "Burst",
          "type": "integer"
        },
        "per_minute": {
          "default": 120,
          "maximum": 6000,
          "minimum": 1,
          "title": "Per Minute",
          "type": "integer"
        }
      },
      "title": "OutsideRateLimit",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "auth": {
      "$ref": "#/$defs/OutsideAuth"
    },
    "listen": {
      "$ref": "#/$defs/OutsideListen",
      "default": {
        "host": "127.0.0.1",
        "port": 8110
      }
    },
    "mask_results": {
      "default": "external",
      "enum": [
        "external",
        "always",
        "never"
      ],
      "title": "Mask Results",
      "type": "string"
    },
    "rate_limit": {
      "$ref": "#/$defs/OutsideRateLimit",
      "default": {
        "burst": 30,
        "per_minute": 120
      }
    }
  },
  "required": [
    "agent",
    "auth"
  ],
  "title": "outside.yaml",
  "type": "object"
}
