#!/bin/bash
# The GPU host for Ollama (ADR 031): Llama Guard and the profile's local models. It has no public
# address; its firewall lets only the apps reach port 11434. Ollama has no sign-in of its own, so
# that network rule is its protection. Installing needs outbound internet (internet_egress).
set -euo pipefail
exec > >(tee -a /var/log/governed-ollama.log) 2>&1

for _ in $(seq 60); do nvidia-smi >/dev/null 2>&1 && break; sleep 10; done   # the GPU driver first
nvidia-smi || echo "warning: no GPU driver yet; Ollama will run on the CPU until it appears"

curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="${ollama_version}" sh

mkdir -p /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/governed.conf <<'EOF'
[Service]
Environment="OLLAMA_HOST=0.0.0.0:11434"
Environment="OLLAMA_KEEP_ALIVE=24h"
EOF
systemctl daemon-reload
systemctl enable --now ollama
systemctl restart ollama
for _ in $(seq 30); do curl -sf http://127.0.0.1:11434/api/version >/dev/null && break; sleep 2; done

%{ for m in models ~}
ollama pull "${m}"
%{ endfor ~}
echo "ollama ready: ${join(" ", models)}"
