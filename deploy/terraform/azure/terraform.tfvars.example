# Copy to terraform.tfvars (not committed) and edit.

name     = "governed"
location = "eastus2"
profile  = "clinic-assistant"

# First apply: false. After pushing the image: true.
deploy_apps = false
image_tag   = "0.1.0"

# The GPU VM's admin key (reachable only from inside the network).
admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.org"

# While deploying from outside the network only; set back to [] afterwards.
operator_cidrs = []

# Outbound internet through NAT (Ollama install and models, web research, FDA labels).
internet_egress = true

ollama_models = ["llama-guard3:8b", "mistral"]

# Sign-in and other settings for every service (no secrets here).
app_env = {}
